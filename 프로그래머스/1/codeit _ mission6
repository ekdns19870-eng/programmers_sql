/*파트1. 데이터 파악하기

어떤 테이블과 컬럼들이 있는지 간단하게 기본 구조를 확인해 봅시다. 그리고 각 테이블에 어떤 형태로 데이터가 들어가 있는지도 확인해 보세요.*/

/*1-1. 존재하는 테이블의 목록과, 각 테이블의 컬럼 정보를 각각 확인해 보세요.
테이블의 목록은 SHOW TABLES; 구문으로, 테이블의 컬럼 정보는 DESCRIBE 테이블_이름; 구문으로 확인할 수 있어요.*/

CREATE DATABASE music_db ;
USE music_db;

SHOW TABLES;
DESCRIBE albums;
DESCRIBE artists;
DESCRIBE history;
DESCRIBE songs;
DESCRIBE users;


-- 1-2. 사용자 목록, 아티스트 목록을 각각 확인해 보세요.

SELECT * FROM users;

SELECT * FROM artists;

-- 1-3. 궁금한 아티스트를 한 명 골라 모든 앨범 목록을 확인해 보세요.

SELECT * 
FROM artists AS t
LEFT JOIN albums AS b ON t.id = b.artist_id
	WHERE name = 'Lisa Fox';


-- 1-4. 사용자를 한 명 골라 가장 최근에 재생한 20곡을 재생 시점 순으로 확인해 보세요. (재생 시점, 사용자 ID, 사용자 계정명, 곡 ID, 곡 제목, 곡 재생 시간(초)를 조회해보세요.)
-- user id , id, music id 

SELECT *
 FROM users AS u
	LEFT JOIN history AS h ON u.id = h.user_id
	LEFT JOIN songs AS s ON h.song_id = s.id
	WHERE user_id = 1
    ORDER BY played_at DESC;
    
/* 파트2. 2024년의 음악

음악계에는 매년 다양한 일들이 벌어집니다. 
기대를 모았던 아티스트가 새 앨범을 발표하기도 하고, 예상치 못한 신인이 차트를 휩쓸기도 하죠.
 2024년의 음악 데이터를 분석해, 그 해에 발매된 앨범과 아티스트들의 활동을 살펴보고 가장 많이 재생된 곡과 아티스트를 확인해 봅시다.
*/

-- 2-1. 2024년에 발매된 모든 앨범을 확인해 보세요. (앨범의 ID, 앨범 제목, 앨범 발매일, 아티스트 이름을 조회해 보세요. 발매순으로 정렬하고 발매일이 같을 경우 앨범의 ID 순으로 정렬하세요.)

SELECT b.id, title, release_date, a.name
FROM albums AS b
LEFT JOIN artists AS a ON b.artist_id = a.id 
WHERE release_date >= '2024-01-01'
ORDER BY release_date ASC ,b.id ASC;
  

-- 2-2. 2024년에 앨범을 발매한 아티스트의 목록을 앨범을 많이 발매한 순서대로 확인해 보세요.  
-- (아티스트 ID, 아티스트 이름, 발매한 앨범의 수를 조회하고, 앨범의 수가 많은 것부터 정렬하되 앨범의 수가 같을 경우 아티스트의 이름 순으로 정렬하세요.)

SELECT a.id, name, COUNT(a.id) AS count_a
FROM artists AS a
LEFT JOIN albums AS b ON a.id = b.artist_id
GROUP BY a.id
ORDER BY count_a DESC, name ASC;


-- 2-3. 2024년에 가장 많이 재생된 20곡을 많이 재생된 순서대로 확인해 보세요.
--  (곡의 ID, 곡 제목, 재생 수를 조회하고, 재생 수가 같을 경우 곡 제목 순으로 정렬하세요.)

SELECT s.id, title, COUNT(s.id) AS count_s
FROM history AS h
LEFT JOIN songs AS s ON s.id = h.song_id
GROUP BY s.id
ORDER BY count_s DESC, title ASC
LIMIT 20;

-- 2-4. 2024년에 가장 많이 재생된 20명의 아티스트를 많이 재생된 순서대로 확인해 보세요. 
-- (아티스트의 ID, 아티스트 이름, 재생 수를 조회하고, 재생 수가 같은 경우 아티스트의 이름 순으로 정렬하세요.)

SELECT a.id, a.name, COUNT(a.id) AS count_artist
FROM history AS h
	LEFT JOIN songs AS s ON h.song_id = s.id
	LEFT JOIN albums AS b on s.album_id = b.id 
	LEFT JOIN artists AS a ON b.artist_id = a.id
WHERE release_date >= '2024-01-01'
GROUP BY a.id
ORDER BY count_artist DESC, name ASC
LIMIT 20;



/* 파트3. 내가 2024년에 들은 음악

한 해 동안 우리는 수많은 음악을 듣습니다. 어떤 날은 같은 곡을 반복해서 듣고, 
또 어떤 날은 새로운 아티스트를 발견하기도 하죠. 재생 기록을 살펴보면 내가 어떤 음악 혹은 어떤 아티스트를 많이 감상했는지, 
그리고 한 달 중 언제 음악을 가장 많이 들었는지 알 수 있습니다. 자유롭게 사용자를 골라 음악 감상 기록을 분석해 한 해 동안의 음악 활동을 다양한 데이터로 확인해 봅시다.
*/

-- 3-1. 특정 사용자가 2024년에 재생한 곡 중에서 가장 최근에 재생한 100곡을 재생 시점 순으로 정렬하여 확인해 보세요. 
-- (사용자 ID, 사용자 계정명, 재생 시점, 곡 제목, 앨범 제목, 아티스트 이름을 조회하세요.)

SELECT u.id, username, played_at, s.title, b.title, a.name
FROM history AS h
LEFT JOIN users AS u ON h.user_id = u.id
LEFT JOIN songs AS s ON h.song_id = s.id
LEFT JOIN albums AS b ON s.album_id = b.id
LEFT JOIN artists AS a ON b.artist_id = a.id

WHERE played_at >= '2024-01-01'
	AND u.id = 1
ORDER BY played_at DESC, u.id ASC
LIMIT 100;

-- 3-2. 특정 사용자가 2024년에 많이 들은 20곡을 많이 들은 순서대로 확인해 보세요. (곡의 ID, 곡 제목, 재생 수를 조회하시오. 재생 수가 같은 경우 곡 제목 순으로 정렬하세요.)

SELECT  s.id, s.title, COUNT(s.id) AS count_song
	FROM history AS h
	LEFT JOIN users AS u ON h.user_id = u.id
	LEFT JOIN songs AS s ON h.song_id = s.id
	LEFT JOIN albums AS b ON s.album_id = b.id
	LEFT JOIN artists AS a ON b.artist_id = a.id

	WHERE played_at  BETWEEN '2024-01-01' and '2024-12-31'
		AND u.id = 1
GROUP BY s.id
ORDER BY count_song DESC, s.title ASC
LIMIT 20;

-- 3-3. 특정 사용자가 2024년에 많이 들은 20명의 아티스트를 많이 들은 순서대로 확인해 보세요. 
-- (아티스트의 ID, 아티스트 이름, 재생 수를 조회하고, 재생 수가 같은 경우 아티스트의 이름 순으로 정렬하세요.)

SELECT  a.id, a.name, COUNT(a.id)AS count_artist
	FROM history AS h
	LEFT JOIN users AS u ON h.user_id = u.id
	LEFT JOIN songs AS s ON h.song_id = s.id
	LEFT JOIN albums AS b ON s.album_id = b.id
	LEFT JOIN artists AS a ON b.artist_id = a.id

	WHERE played_at  BETWEEN '2024-01-01' and '2024-12-31'
		AND u.id = 1
	GROUP BY a.id
    ORDER BY count_artist DESC, a.name ASC
    LIMIT 20;

-- 3-4. 특정 사용자의 2024년 월별 음악 감상 횟수를 확인해 보세요.
-- 년, 월 추출 

SELECT u.id, DATE_FORMAT(played_at, '%Y-%m') AS YYMM, COUNT(*)
	FROM history AS h
	LEFT JOIN users AS u ON h.user_id = u.id
	LEFT JOIN songs AS s ON h.song_id = s.id
	LEFT JOIN albums AS b ON s.album_id = b.id
    WHERE u.id = 1
    GROUP BY YYMM 
    
-- 3-5. 특정 사용자가 2024년 재생한 곡들의 총 재생 시간을 확인해 보세요.

SELECT u.id,  SUM(duration_seconds) AS total_2024
	FROM history AS h 
    LEFT JOIN users AS u ON h.user_id = u.id
    LEFT JOIN songs AS s ON h.song_id = s.id
    
    	WHERE played_at LIKE '2024%'
			AND u.id = 1

-- 3-6. 특정 사용자가 2024년에 새롭게 발견한 아티스트 목록을 확인해 보세요.
-- 2024년도에 처음 재생한 아티스트? 

	SELECT * 
	FROM
		(SELECT u.id, a.name

		FROM history AS h
		LEFT JOIN users AS u ON h.user_id = u.id
		LEFT JOIN songs AS s ON h.song_id = s.id
		LEFT JOIN albums AS b ON s.album_id = b.id
		LEFT JOIN artists AS a ON b.artist_id = a.id

		WHERE played_at  BETWEEN '2024-01-01' and '2024-12-31'
		AND played_at  >= '2024-01-01'
		AND u.id = 1 )AS after_a
		
		
        LEFT JOIN
		(
	-- 24년도 노래를 들어본 적이 없음
	SELECT u.id, a.name
		FROM history AS h
		LEFT JOIN users AS u ON h.user_id = u.id
		LEFT JOIN songs AS s ON h.song_id = s.id
		LEFT JOIN albums AS b ON s.album_id = b.id
		LEFT JOIN artists AS a ON b.artist_id = a.id
		WHERE played_at < '2024-01-01'
		AND u.id = 1
)AS before_a
ON after_a.name = before_a.name
WHERE before_a.name IS NULL







/* 파트4. 나의 음악 감상 패턴 발견하기
이제 기본적인 음악 감상 정보를 넘어, 더 깊이 있는 패턴을 살펴볼 차례입니다. 
특정 사용자가 올해 새롭게 발견한 아티스트는 누구인지, 내가 자주 듣지만 다른 사람들은 잘 듣지 않는 곡이 있는지, 
혹은 요일별 및 시간대별 음악 감상 패턴이 어떻게 다른지 등을 분석해 봅시다. */


-- 4-1. 특정 사용자가 2024년에 특정 아티스트의 곡을 들은 사용자들 중에서 감상 횟수 기준으로 상위 몇 퍼센트(%)에 속하는지 확인해 보세요.
-- 2024 년, 특정 사용자, 특정 아티스트,  감상횟수, 상위 몇 퍼센트,

SELECT *
FROM
(SELECT u.id, a.name, COUNT(h.id) AS count_h, 
	CONCAT
    (ROUND(PERCENT_RANK() OVER (ORDER BY COUNT(h.id) DESC) *100,2),'%' )
    AS ranking
		FROM history AS h
		LEFT JOIN users AS u ON h.user_id = u.id
		LEFT JOIN songs AS s ON h.song_id = s.id
		LEFT JOIN albums AS b ON s.album_id = b.id
		LEFT JOIN artists AS a ON b.artist_id = a.id
		WHERE played_at BETWEEN '2024-01-01' AND '2024-12-31'
        AND a.name = 'Lisa Fox'

	GROUP BY u.id
 ) AS ranking_artist
WHERE id= 1
;
